PROJECT_NAME           = "Stratax"
PROJECT_NUMBER         = 0.3.1

OUTPUT_DIRECTORY       = docs/output
HTML_OUTPUT            = html
EXCLUDE                = docs/output
EXCLUDE_PATTERNS       = */docs/output/*

INPUT                  = include \
                         docs \
                         LICENSE

FILE_PATTERNS          = *.hpp *.h *.md LICENSE

RECURSIVE              = YES

MARKDOWN_SUPPORT       = YES

# Project-specific documentation commands.
# Usage: @complexity O(1)
ALIASES               += complexity="\par Complexity^^"

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
SEARCHENGINE           = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES

USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

GENERATE_TREEVIEW      = YES

HTML_DYNAMIC_MENUS     = YES

OPTIMIZE_OUTPUT_FOR_C  = NO

# Expand dtype registration macros so their specializations are documented.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION         = YES
EXPAND_ONLY_PREDEF      = YES
EXPAND_AS_DEFINED      = STRATAX_DEFINE_DTYPE_TRAITS \
                         STRATAX_DEFINE_FLOAT_DTYPE_TRAITS \
                         STRATAX_DEFINE_COMPLEX_DTYPE_TRAITS \
                         STRATAX_DEFINE_COMPLEX_COMPONENT \
                         STRATAX_DEFINE_COMPLEX_FROM_REAL
