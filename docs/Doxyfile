PROJECT_NAME           = "Stratax"
PROJECT_NUMBER         = 0.2.0

OUTPUT_DIRECTORY       = docs/output
HTML_OUTPUT            = html
EXCLUDE                = docs/output
EXCLUDE_PATTERNS       = */docs/output/*

INPUT                  = include \
                         docs \
                         LICENSE

FILE_PATTERNS          = *.hpp *.md LICENSE

RECURSIVE              = YES

MARKDOWN_SUPPORT       = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
SEARCHENGINE           = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES

USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

GENERATE_TREEVIEW      = YES

HTML_DYNAMIC_MENUS     = YES

OPTIMIZE_OUTPUT_FOR_C  = NO
